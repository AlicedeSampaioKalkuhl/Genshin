mutate(sub1_rv = case_when(sub1 == "HP" & sub1_value < 1 ~ sub1_value/0.0583,
sub1== "HP" & sub1_value > 1 ~ sub1_value/298.75,
sub1== "ATK" & sub1_value < 1 ~ sub1_value/0.0583,
sub1== "ATK" & sub1_value > 1 ~ sub1_value/19.45,
sub1== "DEF" & sub1_value < 1 ~ sub1_value/0.0729,
sub1== "DEF" & sub1_value > 1 ~ sub1_value/23.15,
sub1== "ER" ~ sub1_value/0.0648,
sub1== "EM" ~ sub1_value/23.31,
sub1== "CritRate" ~ sub1_value/0.0389,
sub1== "CritDMG" ~ sub1_value/0.0777),
sub2_rv = case_when(sub2 == "HP" & sub2_value < 1 ~ sub2_value/0.0583,
sub2== "HP" & sub2_value > 1 ~ sub2_value/298.75,
sub2== "ATK" & sub2_value < 1 ~ sub2_value/0.0583,
sub2== "ATK" & sub2_value > 1 ~ sub2_value/19.45,
sub2== "DEF" & sub2_value < 1 ~ sub2_value/0.0729,
sub2== "DEF" & sub2_value > 1 ~ sub2_value/23.15,
sub2== "ER" ~ sub2_value/0.0648,
sub2== "EM" ~ sub2_value/23.31,
sub2== "CritRate" ~ sub2_value/0.0389,
sub2== "CritDMG" ~ sub2_value/0.0777),
sub3_rv = case_when(sub3 == "HP" & sub3_value < 1 ~ sub3_value/0.0583,
sub3== "HP" & sub3_value > 1 ~ sub3_value/298.75,
sub3== "ATK" & sub3_value < 1 ~ sub3_value/0.0583,
sub3== "ATK" & sub3_value > 1 ~ sub3_value/19.45,
sub3== "DEF" & sub3_value < 1 ~ sub3_value/0.0729,
sub3== "DEF" & sub3_value > 1 ~ sub3_value/23.15,
sub3== "ER" ~ sub3_value/0.0648,
sub3== "EM" ~ sub3_value/23.31,
sub3== "CritRate" ~ sub3_value/0.0389,
sub3== "CritDMG" ~ sub3_value/0.0777),
sub4_rv = case_when(sub4 == "HP" & sub4_value < 1 ~ sub4_value/0.0583,
sub4== "HP" & sub4_value > 1 ~ sub4_value/298.75,
sub4== "ATK" & sub4_value < 1 ~ sub4_value/0.0583,
sub4== "ATK" & sub4_value > 1 ~ sub4_value/19.45,
sub4== "DEF" & sub4_value < 1 ~ sub4_value/0.0729,
sub4== "DEF" & sub4_value > 1 ~ sub4_value/23.15,
sub4== "ER" ~ sub4_value/0.0648,
sub4== "EM" ~ sub4_value/23.31,
sub4== "CritRate" ~ sub4_value/0.0389,
sub4== "CritDamage" ~ sub4_value/0.0777),
rv=100*(sub1_rv+sub2_rv+sub3_rv+sub4_rv)) |>
mutate(sub1_cv = case_when(sub1 == "HP" ~ 0,
sub1== "ATK"~ 0,
sub1== "DEF"~ 0,
sub1== "ER" ~ 0,
sub1== "EM" ~ 0,
sub1== "CritRate" ~ sub1_value*2,
sub1== "CritDamage" ~ sub1_value),
sub2_cv = case_when(sub2 == "HP" ~ 0,
sub2== "ATK" ~ 0,
sub2== "DEF" ~ 0,
sub2== "ER" ~ 0,
sub2== "EM" ~ 0,
sub2== "CritRate" ~ sub2_value*2,
sub2== "CritDMG" ~ sub2_value),
sub3_cv = case_when(sub3 == "HP" ~ 0,
sub3== "ATK" ~ 0,
sub3== "DEF" ~ 0,
sub3== "ER" ~ 0,
sub3== "EM" ~ 0,
sub3== "CritRate" ~ sub3_value*2,
sub3== "CritDMG" ~ sub3_value),
sub4_cv = case_when(sub4 == "HP" ~ 0,
sub4== "ATK" ~ 0,
sub4== "DEF" ~ 0,
sub4== "ER" ~ 0,
sub4== "EM" ~ 0,
sub4== "CritRate" ~ sub4_value*2,
sub4== "CritDMG" ~ sub4_value),
cv=100*(sub1_cv+sub2_cv+sub3_cv+sub4_cv)) |> # total roll values
arrange(-cv)
head(artifacts) # 6 highest rv artifacts on the account
colnames(artifacts)
artifacts_summary <- artifacts |>
group_by(set,type,main) |>
summarise(n_have=n(), .groups = 'drop')
artifactfarming_summary <- artifactfarming |> group_by(artifact_set,artifact_type,artifact_main) |>
summarise(n_needed=n(), .groups = 'drop')
farm_me <- left_join(artifactfarming_summary,artifacts_summary, by=c("artifact_set"="set","artifact_type"="type","artifact_main"="main")) |>
mutate_all(~replace(., is.na(.), 0)) |>
mutate(n_need=n_needed-n_have)
farm_me |>
select(c("artifact_set","artifact_type","artifact_main","n_need")) |>
arrange(-n_need) |>
write.table("artifactfarming.csv",sep=",",row.names=FALSE,quote=FALSE)
farm_me |>
group_by(artifact_set) |>
summarise(farm=n(), .groups = 'drop') |>
arrange(-farm)
